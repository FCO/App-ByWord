use Test;
use App::ByWord;

subtest 'by-word integration runs', {
    my $s = supply {
        .emit for <Hello world this is fast>.words;
        done;
    }
    my $null = '/dev/null'.IO.open(:w);
    lives-ok({
        temp $*OUT = $null;
        temp $*ERR = $null;
        temp %*ENV<TERM>    = 'xterm';
        temp %*ENV<COLUMNS> = '80';
        by-word $s, :wpm(600), :!border, :line-no(5), :to-left(1);
    }, 'by-word completes for short supply');
    $null.close;
}

done-testing;
